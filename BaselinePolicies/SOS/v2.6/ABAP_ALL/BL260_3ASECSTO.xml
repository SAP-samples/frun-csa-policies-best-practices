<?xml version="1.0" encoding="utf-8"?>
<!-- 
Source:             This policy corresponds to SAP Security Baseline Template v2.6.
                    It is provided as a sample for customers to use to get an accelerated start for analysing the landscape using SAP Focused Run (FRUN) Configuration and Security Analysis (CSA) application.  It shows how rules can be defined for a variety of requirements.  Customers can take these rules and adapt to their corporate needs.

Source Reference:   SAP Security Baseline Template v2.6 (2025/07), as signposted by SAP KBA 2253549.
Source Link:        https://support.sap.com/content/dam/support/en_us/library/ssp/offerings-and-programs/support-services/sap-security-optimization-services-portfolio/Security_Baseline_Template_V2.zip
-->
<!-- -->
<!--    SAP Security Baseline requirement:      SECSTO-A: Protection of Secure Store – ABAP
        Security level:                         Extended (Level 3)

        Policy Version:     Date:           Owner:          Comment:
        v2.6.0              2026-03-17      XX-SER-SECCHK   

        Note: Configuration Store ABAP_INSTANCE_PAHI reflects runtime configuration of Dialog Instances.  Runtime Configuration of ASCS instance and ERS instance is in Parameters Store with separate sci_ids, hence system_attributes="SYSTEM_TYPE:ABAP" used at check level.  Rules for all are provided so customer can select the rule relevative to their context including single-instance systems.
 -->
<!-- xxxxxxxxxxxxxxxxxxxx END OF INTRODUCTION xxxxxxxxxxxxxxxxxxxx -->
<!-- -->
<targetsystem xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" desc="[BL2.6.0] Protection of Secure Store (ABAP)" id="BL260_3ASECSTO" multisql="Yes" version="0000" xsi:schemaLocation="csa_policy.xsd">
  <!--  -->
  <configstore name="ABAP_SECSTORE_INFO">
    <!-- -->
    <checkitem desc="[p3-EXTENDED] Encryption key for new/updated records not Default Key (SECSTORE individual master key, see Note 1902258)" id="SECSTO-A_a.1">
      <compliant>       NAME like 'Encryption%' and     VALUE like '%OK%'   </compliant>
      <noncompliant>    NAME like 'Encryption%' and not VALUE like '%OK%'   </noncompliant>
    </checkitem>
    <!-- -->
  </configstore>
  <!--  -->
  <!-- xxxxxxxxxxxxxxxxxxxx -->
  <!--  -->
  <configstore name="ABAP_INSTANCE_PAHI">
    <!-- -->
    <!-- The following rule checks the path on Widondows or Linus systems pointing to the global directory for SecStoreDBKey.pse.  This is a sample and customers can maintain as per their requirements. -->
    <checkitem desc="[p3-EXTENDED] Profile parameter: rsec/securestorage/keyfile set as expected (SecStoreDBKey.pse key file location, see Note 1902611)" id="SECSTO-A_a.2">
      <compliant>       NAME = 'rsec/securestorage/keyfile' 
                        and     VALUE like_regexpr '(\w:)?([\/\\]usr[\/\\]sap|[\/\\]sapmnt)[\/\\](\w{3})[\/\\]SYS[\/\\]global[\/\\]security[\/\\]data[\/\\](SecStoreDBKey.pse)'    </compliant>
      <noncompliant>    NAME = 'rsec/securestorage/keyfile' 
                        and not VALUE like_regexpr '(\w:)?([\/\\]usr[\/\\]sap|[\/\\]sapmnt)[\/\\](\w{3})[\/\\]SYS[\/\\]global[\/\\]security[\/\\]data[\/\\](SecStoreDBKey.pse)'    </noncompliant>
    </checkitem>
    <!-- -->
  </configstore>
  <!--  -->
  <!-- xxxxxxxxxxxxxxxxxxxx -->
  <!--  -->
  <configstore name="Parameters">
    <!-- -->
    <!-- The following rule checks the path on Windows or Linus systems pointing to the global directory for SecStoreDBKey.pse.  This is a sample and customers can maintain as per their requirements. -->
    <checkitem desc="[p3-EXTENDED] Profile parameter: rsec/securestorage/keyfile set as expected (SecStoreDBKey.pse key file location, see Note 1902611)" id="SECSTO-A_a.2" system_attributes="SYSTEM_TYPE:ABAP">
      <compliant>       NAME = 'rsec/securestorage/keyfile' 
                        and     VALUE like_regexpr '(\w:)?([\/\\]usr[\/\\]sap|[\/\\]sapmnt)[\/\\](\w{3})[\/\\]SYS[\/\\]global[\/\\]security[\/\\]data[\/\\](SecStoreDBKey.pse)'    </compliant>
      <noncompliant>    NAME = 'rsec/securestorage/keyfile' 
                        and not VALUE like_regexpr '(\w:)?([\/\\]usr[\/\\]sap|[\/\\]sapmnt)[\/\\](\w{3})[\/\\]SYS[\/\\]global[\/\\]security[\/\\]data[\/\\](SecStoreDBKey.pse)'    </noncompliant>
    </checkitem>
    <!-- -->
  </configstore>
  <!-- -->
</targetsystem>