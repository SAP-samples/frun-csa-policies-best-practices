  <!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->
  <!-- -->
  <configstore name="MS_SECINFO">
    <!-- -->
    <!-- The following compliance rule will accept entries such as HOST=ABC, or HOST=*.ABC where partial qualification has been considered. -->
    <checkitem desc="[p3-EXTENDED] Message Server ACL should not contain generic entries (ACL file, Message Server Security)" id="MSGSRV-A_e.3">
      <compliant>       line like '%' and     text like_regexpr 'HOST=[ \t]*([^* \t]|[*][a-zA-Z0-9.]).*'    </compliant>
      <noncompliant>    line like '%' and not text like_regexpr 'HOST=[ \t]*([^* \t]|[*][a-zA-Z0-9.]).*'    </noncompliant>
      <joinstore name="ABAP_INSTANCE_PAHI" no_data_found="No" not_in_output="No">
        <joincompliant>     NAME = 'system/secure_communication' and VALUE = 'ON'       </joincompliant>
        <joinnoncompliant>  NAME = 'system/secure_communication' and VALUE = 'ON'       </joinnoncompliant>
      </joinstore>
    </checkitem>
    <!-- -->
    <!-- The following compliance rule will accept entries such as HOST=ABC, or HOST=*.ABC where partial qualification has been considered. -->
    <checkitem desc="[p3-EXTENDED] Message Server ACL should not contain generic entries (ACL file, Message Server Security)" id="MSGSRV-A_e.3" system_attributes="SYSTEM_TYPE:ABAP">
      <compliant>       line like '%' and     text like_regexpr 'HOST=[ \t]*([^* \t]|[*][a-zA-Z0-9.]).*'    </compliant>
      <noncompliant>    line like '%' and not text like_regexpr 'HOST=[ \t]*([^* \t]|[*][a-zA-Z0-9.]).*'    </noncompliant>
      <joinstore name="Parameters" no_data_found="No" not_in_output="No">
        <joincompliant>     NAME = 'system/secure_communication' and VALUE = 'ON'       </joincompliant>
        <joinnoncompliant>  NAME = 'system/secure_communication' and VALUE = 'ON'       </joinnoncompliant>
      </joinstore>
    </checkitem>
    <!-- -->
  </configstore>
  <!-- -->
</targetsystem>