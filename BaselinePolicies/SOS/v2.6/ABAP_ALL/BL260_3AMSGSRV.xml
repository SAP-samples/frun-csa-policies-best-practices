<!-- -->
<!--    SAP Security Baseline requirement:      MSGSRV-A: Message Server Security
        Security level:                         Extended (Level 3)

        Policy Version:     Date:           Owner:          Comment:
        v2.6.0              2026-03-17      XX-SER-SECCHK   

        Note: Configuration Store ABAP_INSTANCE_PAHI reflects runtime configuration of Dialog Instances.  Runtime Configuration of ASCS instance and ERS instance is in Parameters Store with separate sci_ids, hence system_attributes="SYSTEM_TYPE:ABAP" used at check level.  Rules for all are provided so customer can select the rule relevative to their context including single-instance systems.
 -->
<!-- xxxxxxxxxxxxxxxxxxxx END OF INTRODUCTION xxxxxxxxxxxxxxxxxxxx -->
<!-- -->
<targetsystem desc="[BL2.6.0] Message Server Security (ABAP)" id="BL260_3AMSGSRV" multisql="Yes" version="0000">
  <!-- -->
  <configstore name="ABAP_INSTANCE_PAHI">
    <!-- -->
    <!-- These checks are less critical if system/secure_communication = ON. Hence included in Extended Check using Join. It uses a regular expression with or conditions to validate the path in Windows or Linux environments.-->
    <checkitem desc="[p3-EXTENDED] Profile parameter: ms/acl_info is maintained (Message Server Security, pointing to access control list file for Message Server" id="MSGSRV-A_d.3">
      <compliant>       NAME = 'ms/acl_info' 
                        and     VALUE like_regexpr '(\w:)?([\/\\]usr[\/\\]sap|[\/\\]sapmnt)[\/\\](\w{3})([\/\\]SYS)?[\/\\]global[\/\\]ms_acl(_info)?(\.DAT|\.dat|\.txt)?'  </compliant>
      <noncompliant>    NAME = 'ms/acl_info' 
                        and not VALUE like_regexpr '(\w:)?([\/\\]usr[\/\\]sap|[\/\\]sapmnt)[\/\\](\w{3})([\/\\]SYS)?[\/\\]global[\/\\]ms_acl(_info)?(\.DAT|\.dat|\.txt)?'  </noncompliant>
      <joinstore name="ABAP_INSTANCE_PAHI" no_data_found="No" not_in_output="No">
        <joincompliant>     NAME = 'system/secure_communication' and VALUE = 'ON'      </joincompliant>
        <joinnoncompliant>  NAME = 'system/secure_communication' and VALUE = 'ON'      </joinnoncompliant>
      </joinstore>
    </checkitem>
    <!-- -->
  </configstore>
  <!-- -->
  <!-- OLD SYNTAX retained for reference:
    <checkitem desc="[p3-EXTENDED] Profile parameter: ms/acl_info is maintained (Message Server Security, pointing to access control list file for Message Server" id="MSGSRV-A_d.3">
      <compliant>       NAME = 'ms/acl_info' 
                        and     (  VALUE like_regexpr '^/usr/sap/(\w{3})/SYS/global/ms_acl_info'
                                or VALUE like_regexpr '^/sapmnt/(\w{3})/SYS/global/ms_acl_info'
                                or VALUE like_regexpr '^\w:\\usr\\sap\\(\w{3})\\SYS\\global\\ms_acl_info(\.DAT|\.dat)?' )         </compliant>
      <noncompliant>    NAME = 'ms/acl_info' 
                        and not (  VALUE like_regexpr '^/usr/sap/(\w{3})/SYS/global/ms_acl_info'
                                or VALUE like_regexpr '^/sapmnt/(\w{3})/SYS/global/ms_acl_info'
                                or VALUE like_regexpr '^\w:\\usr\\sap\\(\w{3})\\SYS\\global\\ms_acl_info(\.DAT|\.dat)?' )         </noncompliant>
      <joinstore name="ABAP_INSTANCE_PAHI" no_data_found="No" not_in_output="No">
        <joincompliant>     NAME = 'system/secure_communication' and VALUE = 'ON'      </joincompliant>
        <joinnoncompliant>  NAME = 'system/secure_communication' and VALUE = 'ON'      </joinnoncompliant>
      </joinstore>
    </checkitem>
    -->
  <!-- -->
  <!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->
  <!-- -->
  <configstore name="Parameters">
    <!-- -->
    <!-- These checks are less critical if system/secure_communication = ON. Hence included in Extended Check using Join. It uses a regular expression with or conditions to validate the path in Windows or Linux environments.-->
    <checkitem desc="[p3-EXTENDED] Profile parameter: ms/acl_info is maintained (Message Server Security, pointing to access control list file for Message Server" id="MSGSRV-A_d.3" system_attributes="SYSTEM_TYPE:ABAP">
      <compliant>       NAME = 'ms/acl_info' 
                        and     VALUE like_regexpr '(\w:)?([\/\\]usr[\/\\]sap|[\/\\]sapmnt)[\/\\](\w{3})([\/\\]SYS)?[\/\\]global[\/\\]ms_acl(_info)?(\.DAT|\.dat|\.txt)?'  </compliant>
      <noncompliant>    NAME = 'ms/acl_info' 
                        and not VALUE like_regexpr '(\w:)?([\/\\]usr[\/\\]sap|[\/\\]sapmnt)[\/\\](\w{3})([\/\\]SYS)?[\/\\]global[\/\\]ms_acl(_info)?(\.DAT|\.dat|\.txt)?'  </noncompliant>
      <joinstore name="Parameters" no_data_found="No" not_in_output="No">
        <joincompliant>     NAME = 'system/secure_communication' and VALUE = 'ON'      </joincompliant>
        <joinnoncompliant>  NAME = 'system/secure_communication' and VALUE = 'ON'      </joinnoncompliant>
      </joinstore>
    </checkitem>
    <!-- -->
  </configstore>
  <!-- -->
  <!-- OLD SYNTAX retained for reference:
    <checkitem desc="[p3-EXTENDED] Profile parameter: ms/acl_info is maintained (Message Server Security, pointing to access control list file for Message Server" id="MSGSRV-A_d.3" system_attributes="SYSTEM_TYPE:ABAP">
      <compliant>       NAME = 'ms/acl_info' 
                        and     (  VALUE like_regexpr '^/usr/sap/(\w{3})/SYS/global/ms_acl_info'
                                or VALUE like_regexpr '^/sapmnt/(\w{3})/SYS/global/ms_acl_info'
                                or VALUE like_regexpr '^\w:\\usr\\sap\\(\w{3})\\SYS\\global\\ms_acl_info(\.DAT|\.dat)?' )         </compliant>
      <noncompliant>    NAME = 'ms/acl_info' 
                        and not (  VALUE like_regexpr '^/usr/sap/(\w{3})/SYS/global/ms_acl_info'
                                or VALUE like_regexpr '^/sapmnt/(\w{3})/SYS/global/ms_acl_info'
                                or VALUE like_regexpr '^\w:\\usr\\sap\\(\w{3})\\SYS\\global\\ms_acl_info(\.DAT|\.dat)?' )         </noncompliant>
      <joinstore name="Parameters" no_data_found="No" not_in_output="No">
        <joincompliant>     NAME = 'system/secure_communication' and VALUE = 'ON'      </joincompliant>
