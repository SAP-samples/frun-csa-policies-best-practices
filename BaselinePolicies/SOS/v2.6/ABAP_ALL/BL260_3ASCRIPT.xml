    <!-- -->
    <checkitem desc="[p3-EXTENDED] Profile parameter: sapgui/user_scripting_per_user = TRUE (Scripting Protection)" id="SCRIPT-A_a.4" system_attributes="SYSTEM_TYPE:ABAP">
      <compliant>       NAME = 'sapgui/user_scripting_per_user' and UPPER(VALUE)  = 'TRUE'      </compliant>
      <noncompliant>    NAME = 'sapgui/user_scripting_per_user' and UPPER(VALUE) != 'TRUE'      </noncompliant>
    </checkitem>
    <!-- -->
    <checkitem desc="[p3-EXTENDED] Profile parameter: sapgui/user_scripting_disable_recording = TRUE (Scripting Protection)" id="SCRIPT-A_a.5" system_attributes="SYSTEM_TYPE:ABAP">
      <compliant>       NAME = 'sapgui/user_scripting_disable_recording' and UPPER(VALUE)  = 'TRUE' </compliant>
      <noncompliant>    NAME = 'sapgui/user_scripting_disable_recording' and UPPER(VALUE) != 'TRUE' </noncompliant>
    </checkitem>
    <!-- -->
    <checkitem desc="[p3-EXTENDED] Profile parameter: sapgui/user_scripting_force_notification = TRUE (Scripting Protection)" id="SCRIPT-A_a.6" system_attributes="SYSTEM_TYPE:ABAP">
      <compliant>       NAME = 'sapgui/user_scripting_force_notification' and UPPER(VALUE)  = 'TRUE' </compliant>
      <noncompliant>    NAME = 'sapgui/user_scripting_force_notification' and UPPER(VALUE) != 'TRUE' </noncompliant>
    </checkitem>
    <!-- -->
    <checkitem desc="[p3-EXTENDED] Profile parameter: sapgui/user_scripting_set_readonly = TRUE (Scripting Protection)" id="SCRIPT-A_a.7" system_attributes="SYSTEM_TYPE:ABAP">
      <compliant>       NAME = 'sapgui/user_scripting_set_readonly' and UPPER(VALUE)  = 'TRUE'      </compliant>
