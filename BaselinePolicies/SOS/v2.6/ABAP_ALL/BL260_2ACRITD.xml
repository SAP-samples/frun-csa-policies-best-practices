<targetsystem xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" desc="[BL2.6.0] Protection of Password Hashes (ABAP)" id="BL260_2ACRITD" multisql="Yes" version="0000" xsi:schemaLocation="csa_policy.xsd">
  <!-- -->
  <configstore name="TDDAT">
    <!-- -->
    <checkitem desc="[p2-STANDARD] Table USH02 assigned to table authorization group SPWD (Access to table protected)" id="CRITAU-A_d.1.1">
      <compliant>       TABNAME = 'USH02' and CCLASS  = 'SPWD'      </compliant>
      <noncompliant>    TABNAME = 'USH02' and CCLASS != 'SPWD'      </noncompliant>
    </checkitem>
    <!-- -->
    <checkitem desc="[p2-STANDARD] Table USR02 assigned to table authorization group SPWD (Access to table protected)" id="CRITAU-A_d.1.2">
      <compliant>       TABNAME = 'USR02' and CCLASS  = 'SPWD'      </compliant>
      <noncompliant>    TABNAME = 'USR02' and CCLASS != 'SPWD'      </noncompliant>
    </checkitem>
    <!-- -->
    <checkitem desc="[p2-STANDARD] Table USRPWDHISTORY assigned to table authorization group SPWD (Access to table protected)" id="CRITAU-A_d.1.3">
      <compliant>       TABNAME = 'USRPWDHISTORY' and CCLASS  = 'SPWD'  </compliant>
      <noncompliant>    TABNAME = 'USRPWDHISTORY' and CCLASS != 'SPWD'  </noncompliant>
    </checkitem>
    <!-- -->
  </configstore>
  <!-- -->
</targetsystem>