<!-- -->
<targetsystem xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" desc="[BL2.6.0] Obsolete Clients (ABAP)" id="BL260_2AOBSCNT" multisql="Yes" version="0000" xsi:schemaLocation="csa_policy.xsd">
  <!--  -->
  <configstore name="CLIENTS">
    <!--  -->
    <checkitem desc="[p2-STANDARD] Obsolete Client 066 must NOT exist (see Note 1749142)" id="OBSCNT-A_a.1" operator="NOT_EXIST">
      <compliant>       MANDT = '066'    </compliant>
      <noncompliant>    MANDT = '066'    </noncompliant>
    </checkitem>
    <!--  -->
    <checkitem desc="[p2-STANDARD] Template Client 001 must be deleted IF not used (review the context of the situation, these clients are not marked as Live)" id="OBSCNT-A_a.2" operator="NOT_EXIST">
      <compliant>       MANDT = '001' and CCCATEGORY != 'P'     </compliant>
      <noncompliant>    MANDT = '001' and CCCATEGORY != 'P'     </noncompliant>
    </checkitem>
    <!--  -->
  </configstore>
  <!--  -->
</targetsystem>