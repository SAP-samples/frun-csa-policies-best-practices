<!--    SAP Security Baseline requirement:          AUTHASSIGN-A: Assignment of Authorizations – ABAP
        Security level:                             Standard (Level 2)

        Policy Version:     Date:           Owner:          Comment:
        v2.6.0              2026-03-17      XX-SER-SECCHK   original for GA
 -->
<!-- xxxxxxxxxxxxxxxxxxxx END OF INTRODUCTION xxxxxxxxxxxxxxxxxxxx -->
<!-- -->
<targetsystem xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" desc="[BL2.6.0] Assignment of Authorizations (ABAP)" id="BL260_2AAUTHASSIGN" multisql="Yes" version="0000" xsi:schemaLocation="csa_policy.xsd">
  <!-- -->
  <configstore name="PRGN_CUST">
    <!-- -->
    <checkitem desc="[p2-STANDARD] Prohibit user assignments while exporting transports (Customizing switch US_ASGM_TRANSPORT = NO in table PRGN_CUST, see Note 1723881)" id="AUTHASSIGN-A_a">
      <compliant>       ID = 'US_ASGM_TRANSPORT' and UPPER(PATH)  = 'NO'    </compliant>
      <noncompliant>    ID = 'US_ASGM_TRANSPORT' and UPPER(PATH) != 'NO'    </noncompliant>
    </checkitem>
    <!-- -->
    <checkitem desc="[p2-STANDARD] Prohibit user assignments while importing transports (Customizing switch USER_REL_IMPORT = NO in table PRGN_CUST, see Note 571276)" id="AUTHASSIGN-A_b">
      <compliant>       ID = 'USER_REL_IMPORT' and UPPER(PATH)  = 'NO'      </compliant>
      <noncompliant>    ID = 'USER_REL_IMPORT' and UPPER(PATH) != 'NO'      </noncompliant>
    </checkitem>
    <!-- -->
  </configstore>
  <!-- -->
</targetsystem>