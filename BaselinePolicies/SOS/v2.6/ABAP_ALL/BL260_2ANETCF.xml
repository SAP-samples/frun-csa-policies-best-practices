<!--    SAP Security Baseline requirement:      NETCF-A: Secure Network Configuration – ABAP
        Security level:                         Standard (Level 2)

        Policy Version:     Date:           Owner:          Comment:
        v2.6.0              2026-07-17      XX-SER-SECCHK   

        Note: Configuration Store ABAP_INSTANCE_PAHI reflects runtime configuration of Dialog Instances.  Runtime Configuration of ASCS instance and ERS instance is in Parameters Store with separate sci_ids, hence system_attributes="SYSTEM_TYPE:ABAP" used at check level.  Rules for all are provided so customer can select the rule relevative to their context including single-instance systems.
 -->
<!-- xxxxxxxxxxxxxxxxxxxx END OF INTRODUCTION xxxxxxxxxxxxxxxxxxxx -->
<!-- -->
<targetsystem desc="[BL2.6.0] Secure Network Configuration (ABAP)" id="BL260_2ANETCF" multisql="Yes" version="0000">
  <!--  -->
  <configstore name="ABAP_INSTANCE_PAHI">
    <!--  -->
    <checkitem desc="[p2-STANDARD] Profile parameter: auth/rfc_authority_check = 1 6 or 9 (Secure Network Configuration, execution option for the RFC authority check, see Note 2216306)" id="NETCF-A_a">
      <compliant>       NAME = 'auth/rfc_authority_check' and     VALUE in ('1', '6', '9')     </compliant>
      <noncompliant>    NAME = 'auth/rfc_authority_check' and not VALUE in ('1', '6', '9')     </noncompliant>
    </checkitem>
    <!-- -->
    <checkitem desc="[p2-STANDARD] Profile parameter: rfc/callback_security_method = 3 (Secure Network Configuration, block unauthorized remote RFC callbacks, see Note 2678501)" id="NETCF-A_b">
      <compliant>       NAME = 'rfc/callback_security_method' and VALUE  = '3'     </compliant>
      <noncompliant>    NAME = 'rfc/callback_security_method' and VALUE != '3'     </noncompliant>
    </checkitem>
    <!-- -->
    <checkitem desc="[p2-STANDARD] Profile parameter: rfc/selftrust = 0 (Secure Network Configuration, see Notes 2449757, 2614667)" id="NETCF-A_c">
      <compliant>       NAME = 'rfc/selftrust' and VALUE  = '0'     </compliant>
      <noncompliant>    NAME = 'rfc/selftrust' and VALUE != '0'     </noncompliant>
    </checkitem>
    <!-- -->
    <checkitem desc="[p2-STANDARD] Profile parameter: ixml/dtd_restriction = expansion or prohibited (Secure Network Configuration) (see Notes 2308217, 1712860)" id="NETCF-A_e">
      <compliant>       NAME = 'ixml/dtd_restriction' and     ( VALUE = 'expansion' or VALUE = 'prohibited' )   </compliant>
      <noncompliant>    NAME = 'ixml/dtd_restriction' and not ( VALUE = 'expansion' or VALUE = 'prohibited' )   </noncompliant>
    </checkitem>
    <!-- -->
    <checkitem desc="[p2-STANDARD] Profile parameter: login/disable_cpic = 1 (Secure Network Configuration, see Note 2926224)" id="NETCF-A_f">
      <compliant>       NAME = 'login/disable_cpic' and VALUE  = '1'    </compliant>
      <noncompliant>    NAME = 'login/disable_cpic' and VALUE != '1'    </noncompliant>
    </checkitem>
    <!-- -->
    <checkitem desc="[p2-STANDARD] Profile parameter: wdisp/add_xforwardedfor_header = 1 or TRUE (Secure Network Configuration, see Note 2788140)" id="NETCF-A_g">
      <compliant>       NAME = 'wdisp/add_xforwardedfor_header' and     ( VALUE = '1' or UPPER(VALUE) = 'TRUE' )       </compliant>
      <noncompliant>    NAME = 'wdisp/add_xforwardedfor_header' and not ( VALUE = '1' or UPPER(VALUE) = 'TRUE' )       </noncompliant>
    </checkitem>
    <!--   -->
  </configstore>
  <!--   -->
  <!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->
