<!--  
Source:             This policy corresponds to SAP Security Baseline Template v2.6.
                    It is provided as a sample for customers to use to get an accelerated start for analysing the landscape using SAP Focused Run (FRUN) Configuration and Security Analysis (CSA) application.  It shows how rules can be defined for a variety of requirements.  Customers can take these rules and adapt to their corporate needs.

Source Reference:   SAP Security Baseline Template v2.6 (2025/07), as signposted by SAP KBA 2253549.
Source Link:        https://support.sap.com/content/dam/support/en_us/library/ssp/offerings-and-programs/support-services/sap-security-optimization-services-portfolio/Security_Baseline_Template_V2.zip
 -->
<!--   -->
<!--     SAP Security Baseline requirement:          AUDIT-H: Audit Settings – HANA
        Security level:                             Critical (Level 1)

        Policy Version:     Date:           Owner:          Comment:
        v2.6.0              2026-07-17      XX-SER-SECCHK   As CSA doesn’t get data of HANA secondary Database in Disaster Recovery LOGREPLAY mode, we have to exclude those from validation.  Check are only applied to physical (non-virtualized) environments.

        Policy Comments:
            system_attributes="DB_SYSTEMDB:TRUE"    where FILE_NAME = nameserver.ini
            system_attributes="DB_TENANT:TRUE       where FILE_NAME = global.ini
         -->
<!--  xxxxxxxxxxxxxxxxxxxx END OF INTRODUCTION xxxxxxxxxxxxxxxxxxxx  -->
<!--   -->
<targetsystem xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" desc="[BL2.6.0] Audit Settings (HANA)" id="BL260_1HAUDIT" multisql="Yes" version="0000" xsi:schemaLocation="csa_policy.xsd">
<!--   -->
<configstore name="HDB_PARAMETER">
<!--   -->
<!--  CHECK OF DB_TENANT PARAMETERS ON THE GLOBAL.INI file  -->
<!--   -->
<checkitem desc="[p1-CRITICAL] Auditing enabled global_auditing_state = TRUE (DB_TENANT, global.ini)" id="AUDIT-H_a Ten" system_attributes="DB_TENANT:TRUE;DB_REPL_OP_MODE:!LOGREPLAY;DB_VIRTUAL:FALSE">
<compliant> FILE_NAME = 'global.ini' and LAYER like '%' and HOST like '%' and SECT = 'auditing configuration' and NAME = 'global_auditing_state' and UPPER(VALUE) = 'TRUE' </compliant>
<noncompliant> FILE_NAME = 'global.ini' and LAYER like '%' and HOST like '%' and SECT = 'auditing configuration' and NAME = 'global_auditing_state' and UPPER(VALUE) != 'TRUE' </noncompliant>
</checkitem>
<!--   -->
<!--  CHECK OF SYSTEM DB PARAMETERS ON THE NAMESERVER.INI file  -->
<!--   -->
<checkitem desc="[p1-CRITICAL] Auditing enabled global_auditing_state = TRUE (SYSTEMDB, nameserver.ini)" id="AUDIT-H_a Sys" system_attributes="DB_SYSTEMDB:TRUE;DB_REPL_OP_MODE:!LOGREPLAY;DB_VIRTUAL:FALSE">
<compliant> FILE_NAME = 'nameserver.ini' and LAYER like '%' and HOST like '%' and SECT = 'auditing configuration' and NAME = 'global_auditing_state' and UPPER(VALUE) = 'TRUE' </compliant>
<noncompliant> FILE_NAME = 'nameserver.ini' and LAYER like '%' and HOST like '%' and SECT = 'auditing configuration' and NAME = 'global_auditing_state' and UPPER(VALUE) != 'TRUE' </noncompliant>
</checkitem>
<!--   -->
</configstore>
<!--   -->
</targetsystem>
