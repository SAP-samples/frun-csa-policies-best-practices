<targetsystem desc="[BL2.6.0] Secure Network Configuration (WebDispatcher)" id="BL260_2ONETCF" multisql="Yes" version="0000">
  <!--  -->
  <configstore name="Parameters" sci_id="S00444">
    <!--  -->
    <checkitem desc="[p2-STANDARD] Profile parameter wdisp/add_xforwardedfor_header" id="NETCF-A_g">
      <compliant>    NAME = 'wdisp/add_xforwardedfor_header' and     ( VALUE = '1' or UPPER(VALUE) = 'TRUE' )      </compliant>
      <noncompliant> NAME = 'wdisp/add_xforwardedfor_header' and not ( VALUE = '1' or UPPER(VALUE) = 'TRUE' )      </noncompliant>
    </checkitem>
    <!-- -->
  </configstore>
  <!-- -->
</targetsystem>