<targetsystem xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" desc="[BL2.6.0] Audit Settings (BTP)" id="BL260_2PAUDIT" multisql="Yes" version="0000" xsi:schemaLocation="csa_policy.xsd">
  <!-- -->
  <configstore name="SCC_CONFIG" sci_id="S00367">
    <!-- -->
    <checkitem desc="[p2-STANDARD] auditLevel = SECURITY (Audit Log Level of the Cloud Connector(s) for BTP should be set to Security)" id="AUDIT-P_b">
      <compliant>      NAME = 'auditLevel' and UPPER(VALUE)  = 'SECURITY'   </compliant>
      <noncompliant>   NAME = 'auditLevel' and UPPER(VALUE) != 'SECURITY'   </noncompliant>
    </checkitem>
    <!-- -->
  </configstore>
  <!-- -->
</targetsystem>
