<?xml version="1.0" encoding="utf-8"?>
<!-- 
Source:             This policy corresponds to SAP Security Baseline Template v2.6.
                    It is provided as a sample for customers to use to get an accelerated start for analysing the landscape using SAP Focused Run (FRUN) Configuration and Security Analysis (CSA) application.  It shows how rules can be defined for a variety of requirements.  Customers can take these rules and adapt to their corporate needs.

Source Reference:   SAP Security Baseline Template v2.6 (2025/07), as signposted by SAP KBA 2253549.
Source Link:        https://support.sap.com/content/dam/support/en_us/library/ssp/offerings-and-programs/support-services/sap-security-optimization-services-portfolio/Security_Baseline_Template_V2.zip
-->
<!-- -->
<!--    SAP Security Baseline requirement:          AUDIT-J: Audit Settings – Java
        Security level:                             Extended (Level 3)

        Policy Version:     Date:           Owner:          Comment:
        v2.6.0              2026-06-17      XX-SER-SECCHK   

        There is Configuration Store xmlhardener_srv for Technical System which is separate to the xmlhardener_srv for Server node instances. As these stores only exist for JAVA systems, it is only necessary to name the store once, the sci_id is not necessary.
-->
<!-- xxxxxxxxxxxxxxxxxxxx END OF INTRODUCTION xxxxxxxxxxxxxxxxxxxx -->
<!-- -->
<targetsystem xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" desc="[BL2.6.0] Audit Settings (JAVA)" id="BL260_3JAUDIT" multisql="Yes" version="0000" xsi:schemaLocation="csa_policy.xsd">
  <!-- -->
  <configstore name="xmlhardener_srv">
    <!-- -->
    <checkitem desc="[p3-EXTENDED] Java property: enable.xml.hardener = TRUE (enable XML Hardener, see Note 2372626)" id="AUDIT-J_a">
      <compliant>       NAME = 'enable.xml.hardener' and UPPER(VALUE)  = 'TRUE'     </compliant>
      <noncompliant>    NAME = 'enable.xml.hardener' and UPPER(VALUE) != 'TRUE'     </noncompliant>
    </checkitem>
    <!-- -->
  </configstore>
  <!-- -->
</targetsystem>