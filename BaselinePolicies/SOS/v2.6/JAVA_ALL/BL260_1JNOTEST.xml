<!-- -->
<!--    SAP Security Baseline requirement:      NOTEST-J: No Testing Functionality in Production – JAVA
        Security level:                         Critical (Level 1)

        Policy Version:     Date:           Owner:          Comment:
        v2.6.0              2026-03-17      XX-SER-SECCHK   

        Note: There is a servlet_jsp Configuration Store for the Technical System and a separate servlet_jsp Configuration Store for the Servcer Node instances.  As these stores only exist for JAVA systems, it is only necessary to name the store once, the sci_id is not necessary.
 -->
<!-- xxxxxxxxxxxxxxxxxxxx END OF INTRODUCTION xxxxxxxxxxxxxxxxxxxx -->
<!-- -->
<targetsystem xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" desc="[BL2.6.0] No Testing Functionality in Production (JAVA)" id="BL260_1JNOTEST" multisql="Yes" version="0000" xsi:schemaLocation="csa_policy.xsd">
  <!--  -->
  <configstore name="servlet_jsp">
    <!-- -->
    <checkitem desc="[p1-CRITICAL] Java property: EnableInvokerServletGlobally = FALSE (InvokerServlet globally disabled)" id="NOTEST-J_a">
      <compliant>       NAME = 'EnableInvokerServletGlobally' and UPPER(VALUE)  = 'FALSE'    </compliant>
      <noncompliant>    NAME = 'EnableInvokerServletGlobally' and UPPER(VALUE) != 'FALSE'    </noncompliant>
    </checkitem>
    <!--  -->
  </configstore>
  <!--  -->
</targetsystem>