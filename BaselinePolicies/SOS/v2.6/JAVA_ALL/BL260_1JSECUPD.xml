Source:             This policy corresponds to SAP Security Baseline Template v2.6.
                    It is provided as a sample for customers to use to get an accelerated start for analysing the landscape using SAP Focused Run (FRUN) Configuration and Security Analysis (CSA) application.  It shows how rules can be defined for a variety of requirements.  Customers can take these rules and adapt to their corporate needs.

Source Reference:   SAP Security Baseline Template v2.6 (2025/07), as signposted by SAP KBA 2253549.
Source Link:        https://support.sap.com/content/dam/support/en_us/library/ssp/offerings-and-programs/support-services/sap-security-optimization-services-portfolio/Security_Baseline_Template_V2.zip
-->
<!-- -->
<!--    SAP Security Baseline requirement:      SECUPD-J: Regular Security Updates – JAVA
        Security level:                         Critical (Level 1)

        Policy Version:     Date:           Owner:          Comment:
        v2.6.0              2026-03-17      XX-SER-SECCHK   

        Configuration Store COMP_LEVEL (S00120) contains Software Component versions of ABAP, Web Dispatcher, and JAVA type systems, hence system_attributes="SYSTEM_TYPE:JAVA" used at check level.
 -->
<!-- xxxxxxxxxxxxxxxxxxxx END OF INTRODUCTION xxxxxxxxxxxxxxxxxxxx -->
<!-- -->
<targetsystem xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" desc="[BL2.6.0] Regular Security Updates (JAVA)" id="BL260_1JSECUPD" multisql="Yes" version="0000" xsi:schemaLocation="csa_policy.xsd">
  <!-- -->
  <configstore name="COMP_LEVEL">
    <!-- -->
    <!-- system type should be qualified as store COMP_LEVEL relevant to multiple technologies.-->
    <!-- CD_HIST_DATE is a column associated with the Configuration Store reflecting timestamp of change pointer.-->
    <checkitem desc="[p1-CRITICAL] Software component level last reported change in CCDB: within last 12 months" id="SECUPD-J_a.1" not_found="ignore" system_attributes="SYSTEM_TYPE:JAVA">
      <compliant>       COMPONENT like '%' 
                        and VERSION like '%' 
                        and SP like '%'      
                        and CD_HIST_MOD like '%' 
                        and     TO_DATE(CD_HIST_DATE) &gt;= ADD_DAYS(CURRENT_UTCTIMESTAMP,-365)              </compliant>
      <noncompliant>    COMPONENT like '%' 
                        and VERSION like '%' 
                        and SP like '%'      
                        and CD_HIST_MOD like '%' 
                        and not TO_DATE(CD_HIST_DATE) &gt;= ADD_DAYS(CURRENT_UTCTIMESTAMP,-365)              </noncompliant>
    </checkitem>
    <!-- -->
    <!-- system type should be qualified as store COMP_LEVEL relevant to multiple technologies.-->
    <!-- The column SP_REL_DATE of store COMP_LEVEL is not always updated, hence this compliant check compares 8 digit date when available for SP_REL_DAT, if SP_REL_DATE is NEWER then condition as expressed is TRUE as current date used, otherwise outcome of date check is FALSE as date 0 used.  This approach attempts to handle different behaviours.-->
    <checkitem desc="[p1-CRITICAL] Software component level SP_REL_DATE not older than 24 months" id="SECUPD-J_a.2" not_found="ignore" system_attributes="SYSTEM_TYPE:JAVA">
      <compliant>       COMPONENT like '%' 
                        and VERSION like '%' 
                        and SP like '%'  
                        and SP_REL_DATE != ''
                        and     (add_days(current_date,-730)) &lt; (CASE WHEN SP_REL_DATE like_regexpr '^\d{8,8}$' THEN SP_REL_DATE WHEN SP_REL_DATE = 'NEWER' THEN CURRENT_DATE ELSE '00000000' END)
      </compliant>
      <noncompliant>    COMPONENT like '%' 
                        and VERSION like '%'
                        and SP like '%'
                        and SP_REL_DATE != '' 
                        and not (add_days(current_date,-730)) &lt; (CASE WHEN SP_REL_DATE like_regexpr '^\d{8,8}$' THEN SP_REL_DATE WHEN SP_REL_DATE = 'NEWER' THEN CURRENT_DATE ELSE '00000000' END)
      </noncompliant>
    </checkitem>
    <!-- -->
  </configstore>
  <!-- -->
  <!-- At this time, there is no equivalent to ABAP_NOTES Configuration Store to check for JAVA Security Notes. -->
  <!-- -->
</targetsystem>