<?xml version="1.0" encoding="utf-8"?>
<!-- 
Source:             This policy corresponds to SAP Security Baseline Template v2.6.
                    It is provided as a sample for customers to use to get an accelerated start for analysing the landscape using SAP Focused Run (FRUN) Configuration and Security Analysis (CSA) application.  It shows how rules can be defined for a variety of requirements.  Customers can take these rules and adapt to their corporate needs.

Source Reference:   SAP Security Baseline Template v2.6 (2025/07), as signposted by SAP KBA 2253549.
Source Link:        https://support.sap.com/content/dam/support/en_us/library/ssp/offerings-and-programs/support-services/sap-security-optimization-services-portfolio/Security_Baseline_Template_V2.zip
-->
<!-- -->
<!--    SAP Security Baseline requirement:      RFCGW-J: RFC Gateway Security (part of application server Java)
        Security level:                         Critical (Level 1)

        Policy Version:     Date:           Owner:          Comment:
        v2.6.0              2026-06-17      XX-SER-SECCHK   

        Note: Parameters Store S00439 is for JAVA SCS instance.  Java SCS instance hosts the message server, the enqueue server, and a Gateway process as its core components.  Rules are not defined for the Parameters store S00165 for server nodes.
 -->
<!-- xxxxxxxxxxxxxxxxxxxx END OF INTRODUCTION xxxxxxxxxxxxxxxxxxxx -->
<!-- -->
<targetsystem xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" desc="[BL2.6.0] RFC Gateway (JAVA)" id="BL260_1JRFCGW" multisql="Yes" version="0000" xsi:schemaLocation="csa_policy.xsd">
  <!-- -->
  <configstore name="Parameters" sci_id="S00439">
    <!-- -->
    <!--  At this time in FRUN, it is not possible to validate the contents of the Access Control Lists for Java-based systems.  This must be done manually or in another way. -->
    <!-- -->
    <!-- The following simple rule validates if parameter value contains 2x // or \\ to ensure it's a path-like value - Consider replacing with check for actual path. -->
    <checkitem desc="[p1-CRITICAL] Java property: gw/sec_info (mount path defined to ACL file) (SCS instance)" id="RFCGW-J_b secinfo.1">
      <compliant>       NAME = 'gw/sec_info' and      length(substr_after(substr_after(replace(VALUE,'\','/'),'/'),'/')) &gt; 0     </compliant>
      <noncompliant>    NAME = 'gw/sec_info' and NOT (length(substr_after(substr_after(replace(VALUE,'\','/'),'/'),'/')) &gt; 0)    </noncompliant>
    </checkitem>
    <!--       
    <checkitem desc="[p1-CRITICAL] Java property: gw/sec_info (mount path defined to ACL file) (SCS instance)" id="RFCGW-J_b.1">
      <compliant>       NAME = 'gw/sec_info' and       VALUE like 'your mount path/acl file name'      </compliant>
      <noncompliant>    NAME = 'gw/sec_info' and not ( VALUE like 'your mount path/acl file name' )    </noncompliant>
    </checkitem>
    -->
    <!-- The following simple rule validates if parameter value contains 2x // or \\ to ensure it's a path-like value - Consider replacing with check for actual path. -->
    <checkitem desc="[p1-CRITICAL] Java property: gw/reg_info (mount path defined to ACL file) (SCS instance)" id="RFCGW-J_b reginfo.1">
      <compliant>       NAME = 'gw/reg_info' and      length(substr_after(substr_after(replace(VALUE,'\','/'),'/'),'/')) &gt; 0     </compliant>
      <noncompliant>    NAME = 'gw/reg_info' and NOT (length(substr_after(substr_after(replace(VALUE,'\','/'),'/'),'/')) &gt; 0)    </noncompliant>
    </checkitem>
    <!--       
    <checkitem desc="[p1-CRITICAL] Java property: gw/reg_info (mount path defined to ACL file) (SCS instance)" id="RFCGW-J_b.2">
      <compliant>       NAME = 'gw/reg_info' and       VALUE like 'your mount path/acl file name'       </compliant>
      <noncompliant>    NAME = 'gw/reg_info' and not ( VALUE like 'your mount path/acl file name' )     </noncompliant>
   </checkitem>
   -->
    <checkitem desc="[p1-CRITICAL] Java property: gw/reg_no_conn_info as recommended (Gateway security options Kernel lt 7.40) (SCS instance)" id="RFCGW-J_c.1">
      <compliant>       NAME = 'gw/reg_no_conn_info' and     VALUE in ( '15','31','47','63','79','95','111','127','143','159','175','191','207','223','239','255' )    </compliant>
      <noncompliant>    NAME = 'gw/reg_no_conn_info' and not VALUE in ( '15','31','47','63','79','95','111','127','143','159','175','191','207','223','239','255' )    </noncompliant>
      <joinstore name="SAP_KERNEL" no_data_found="No" not_in_output="No">
        <joincompliant>     NAME = 'KERN_REL' and substring(VALUE,0,3) &lt; '740'</joincompliant>
        <joinnoncompliant>  NAME = 'KERN_REL' and substring(VALUE,0,3) &lt; '740'</joinnoncompliant>
      </joinstore>
    </checkitem>
    <!-- -->
    <!--  As per SAP Note 2776748, the default value for the parameter gw/reg_no_conn_info is 1; it is recommended to set the parameter value to 255 to activate all options. -->
    <checkitem desc="[p1-CRITICAL] Java property: gw/reg_no_conn_info = 255 (recommended) or uneven (Gateway security options Kernel ≥ 7.40, see Note 2776748) (SCS instance)" id="RFCGW-J_c.2">
      <compliant>       NAME = 'gw/reg_no_conn_info' and     VALUE in ('1','255')   </compliant>
      <noncompliant>    NAME = 'gw/reg_no_conn_info' and not VALUE in ('1','255')   </noncompliant>
      <joinstore name="SAP_KERNEL" no_data_found="No" not_in_output="No">
        <joincompliant>     NAME = 'KERN_REL' and substring(VALUE,0,3) &gt;= '740'  </joincompliant>
        <joinnoncompliant>  NAME = 'KERN_REL' and substring(VALUE,0,3) &gt;= '740'  </joinnoncompliant>
      </joinstore>
    </checkitem>
    <!-- -->
    <checkitem desc="[p1-CRITICAL] Java property: gw/acl_mode = 1 (Mode for non existing ACL file) (SCS instance)" id="RFCGW-J_d">
      <compliant>       NAME = 'gw/acl_mode' and VALUE  = '1'   </compliant>
      <noncompliant>    NAME = 'gw/acl_mode' and VALUE != '1'   </noncompliant>
    </checkitem>
    <!-- -->
    <checkitem desc="[p1-CRITICAL] Java property: gw/monitor = 1 (Enable gateway monitor commands) (SCS instance)" id="RFCGW-J_e">
      <compliant>       NAME = 'gw/monitor' and VALUE  = '1'    </compliant>
      <noncompliant>    NAME = 'gw/monitor' and VALUE != '1'    </noncompliant>
    </checkitem>
    <!-- -->
    <checkitem desc="[p1-CRITICAL] Java property: gw/sim_mode = 0 (Disable simulation mode for reg_info and sec_info) (SCS instance)" id="RFCGW-J_f">
      <compliant>       NAME = 'gw/sim_mode' and VALUE  = '0'   </compliant>
      <noncompliant>    NAME = 'gw/sim_mode' and VALUE != '0'   </noncompliant>
    </checkitem>
    <!-- -->
  </configstore>
  <!-- -->
</targetsystem>